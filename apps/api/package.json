{
  "name": "@vaquita/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app-api.ts",
    "start": "tsx src/app-api.ts",
    "bridge-confirmation": "tsx src/scripts/bridge-confirmation.ts",
    "bridge-confirmation:once": "tsx src/scripts/bridge-confirmation.ts --once",
    "reconcile:devnet": "tsx src/scripts/reconcile.ts",
    "reconcile:mainnet": "tsx src/scripts/reconcile.ts",
    "reconcile:testnet": "tsx src/scripts/reconcile.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^15.1.0",
    "@vaquita/avatar": "workspace:*",
    "@vaquita/db": "workspace:*",
    "@vaquita/shared": "workspace:*",
    "ably": "^2.21.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
