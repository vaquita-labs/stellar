# =============================================================================
# @vaquita/api — Variables de entorno
# =============================================================================
# Uso local: copia este archivo a `.env` y rellena los valores.
#
# En Dokploy las variables se reparten en 3 secciones. Abajo están agrupadas
# igual que en el panel para que las copies a la sección correspondiente.
#
# TODAS las variables son REQUERIDAS y se validan con zod al arrancar; el
# proceso sale si falta alguna. Cada una está etiquetada según qué deploy la
# necesita:
#   [api+worker]  schema compartido (@vaquita/shared config/env) — lo corren
#                 tanto el API service como el bridge-worker
#   [api]         schema del API (apps/api/src/config/env.ts)
#   [worker]      schema del bridge-worker (scripts/bridge-confirmation.ts)
# =============================================================================


# =============================================================================
# 1) ENVIRONMENT SETTINGS  (runtime)
# =============================================================================
# [api+worker] Debe ser exactamente development | production | test.
NODE_ENV=production
# [api+worker] Puerto HTTP del API (el worker no abre sockets pero el schema
# compartido lo valida igual).
PORT=3100

# [api+worker] Pooled Postgres connection (port 6543, needs ?pgbouncer=true).
# Consumed by the shared @vaquita/db Prisma client.
DATABASE_URL=postgresql://postgres.<tenant>:<password>@<host>:6543/postgres?pgbouncer=true

# [api] Los endpoints admin exigen este valor exacto en el header
# `x-admin-secret`. Nunca vacío: no existe "open mode".
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=

# [api] Nivel de log de pino: fatal | error | warn | info | debug | trace.
LOG_LEVEL=info

# --- Observability (Grafana Cloud) -------------------------------------------
# [api] 'true' registra GET /api/v1/metrics (Prometheus exposition). Este
# endpoint es PRIVATE-ONLY — lo scrapea Grafana Alloy por la red interna, nunca
# se expone públicamente. Solo el string literal 'true' habilita.
OBSERVABILITY_METRICS_ENABLED=false
# [api] Intervalo de refresh (ms) del collector de métricas de producto
# (TVL/deposits/badges). Solo corre cuando las métricas están habilitadas.
OBSERVABILITY_METRICS_REFRESH_MS=60000

# [api+worker] Realtime (Ably) FULL key (appId.keyId:secret). Server-only: los
# clientes web/admin piden tokens de corta vida a GET /api/v1/ably/token. El
# cliente de Ably se construye al importar el paquete compartido, así que el
# proceso muere al arrancar si falta.
ABLY_KEY=

# ---- Stellar / badges -------------------------------------------------------
# [api] Mainnet | Testnet. La passphrase de red se deriva de esto; el API no
# arranca si está vacía (throw en resolveNetworkPassphrase — pendiente de
# migrar a zod).
STELLAR_NETWORK=Mainnet

# [api+worker] Soroban RPC endpoints, uno por red. Los badges usan el que
# corresponde a STELLAR_NETWORK; el APY siempre usa el de mainnet; el bridge
# worker elige por la red de destino de cada transfer.
STELLAR_MAINNET_SOROBAN_RPC_URL=https://soroban-rpc.mainnet.stellar.org:443
STELLAR_TESTNET_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# [api+worker] Badge signing key: 64-char hex (32-byte raw Ed25519 seed). Todo
# el flujo de mint de badges depende de ella.
# Generate: openssl rand -hex 32
BADGE_SIGNING_SEED=

# [api+worker] Stellar mainnet launch timestamp (Unix ms). Abre la ventana de 7
# días del badge D2 "Mainnet Pioneer".
# Generate: node -e "console.log(Date.parse('2026-06-01T00:00:00Z'))"
MAINNET_LAUNCH_TIMESTAMP=

# ---- Wallet-session auth ----------------------------------------------------
# Mutating /profile endpoints require a session token obtained by signing a
# challenge transaction with the user's wallet (POST /auth/challenge +
# /auth/verify). The challenge uses the USER's account as tx.source (Pollar's
# custodial signer requires that) with sequence 0, so it can never execute
# on-chain; one-shot server-side nonces stop forgeries and replays.
#
# [api] HMAC secret for session tokens (min 32 chars). Must be a fixed value
# shared by every PM2 cluster instance; otherwise each instance signs with a
# different ephemeral key and tokens 401 across instances.
# Generate: openssl rand -hex 32
AUTH_SESSION_SECRET=
# [api] Domain label used as the challenge's manage_data key.
AUTH_HOME_DOMAIN=vaquita.app
# [api] 'false' solo LOGUEA sesiones faltantes/ inválidas en vez de rechazar
# (escape hatch, p.ej. mientras se confirma que cada tipo de wallet puede
# firmar challenges). Valores válidos: true | false.
WALLET_AUTH_ENFORCE=true

# ---- DeFindex ---------------------------------------------------------------
# [api+worker] API de DeFindex para el APY del protocolo. Sin un vault address
# en la config de tokens, el APY cae a Blend-only aunque estas estén seteadas.
DEFINDEX_API_HOST=https://api.defindex.io
DEFINDEX_API_KEY=

# ---- CCTP bridge ------------------------------------------------------------
# [api+worker] Circle Iris endpoints (attestations), uno por environment; se
# elige por la red de ORIGEN de cada transfer.
CIRCLE_CCTP_IRIS_MAINNET_BASE_URL=https://iris-api.circle.com
CIRCLE_CCTP_IRIS_TESTNET_BASE_URL=https://iris-api-sandbox.circle.com

# [worker] 'true' corre un solo batch y sale (igual que --once); 'false'
# loopea. Valores válidos: true | false.
BRIDGE_CONFIRMATION_ONCE=false
# [worker] Cadencia del loop del worker (ms).
BRIDGE_CONFIRMATION_INTERVAL_MS=60000
# [worker] Máximo de filas pending reclamadas por batch.
BRIDGE_CONFIRMATION_BATCH_SIZE=20
# [worker] Cuánto tiempo un worker reclama una fila antes de que otro pueda
# reintentarla. Debe superar el tiempo de procesamiento por batch.
BRIDGE_CONFIRMATION_LEASE_MS=60000
# [worker] Edad máxima de una attestation pending antes de moverla a
# needs_review en vez de pollear para siempre (24 h).
BRIDGE_CONFIRMATION_STALE_AFTER_MS=86400000

# [api+worker] Stellar relayer secret key usada por el bridge worker para
# enviar las tx permissionless de CCTP `mint_and_forward`. Server-only; nunca
# exponer a los clientes web/admin.
BRIDGE_STELLAR_RELAYER_SECRET=
# [api+worker] Fee bid (stroops) y timeout (s) de las tx Stellar relayed.
BRIDGE_STELLAR_RELAYER_FEE_STROOPS=1000000
BRIDGE_STELLAR_RELAYER_TIMEOUT_SECONDS=60

# [worker] Override de la network passphrase de las tx relayed. DEJAR SIN
# SETEAR salvo que sepas exactamente por qué: un valor equivocado hace que cada
# relay hashee contra la red incorrecta. Vacío = se deriva de la red de destino
# del transfer.
# STELLAR_NETWORK_PASSPHRASE=

# ---- Deploy webhook ----------------------------------------------------------
# Leídas por notify.sh (shell, no zod): vacías = las notificaciones se saltan.
# Mismos valores que los build-time secrets de la sección 3.
NOTIFICATION_WEBHOOK_URL=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NOTIFICATION_WEBHOOK_TOKEN=

# ---- Reconciliation CLI (pnpm reconcile:*) -----------------------------------
# Solo para el CLI apps/api/src/scripts/reconcile.ts — ni el API ni el worker
# las leen. El RPC sale de STELLAR_*_SOROBAN_RPC_URL según la red inferida.
# RECONCILIATION_NETWORK=        (mainnet | testnet; default: sufijo del script)
# RECONCILIATION_JOB=            (default: <network>-pool-events)
# RECONCILIATION_OVERLAP_LEDGERS=20
# RECONCILIATION_FALLBACK_LOOKBACK_LEDGERS=500
# RECONCILIATION_ARTIFACT_PATH=  (vacío = no escribe artifact)
# VAQUITA_POOL_CONTRACT_IDS=     (lista separada por comas; default: project config)


# =============================================================================
# 2) BUILD-TIME ARGUMENTS
# El Dockerfile las recibe como ARG. Configúralas en el panel, NO en este file.
# =============================================================================
# DEPLOY_ID                  (agrupa eventos del webhook; default: SHA de git)
# WEBHOOK_SOURCE             (el Dockerfile lo fija en "apps/api")


# =============================================================================
# 3) BUILD-TIME SECRETS
# Info sensible, solo disponible en build. En el Dockerfile se montan como
# --mount=type=secret,id=<nombre>
# =============================================================================
# notification_webhook_url=
# notification_webhook_token=
