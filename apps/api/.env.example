# =============================================================================
# @vaquita/api — Environment variables
# =============================================================================
# Local use: copy this file to `.env` and fill in the values.
#
# In Dokploy the variables are split across 3 sections. They are grouped below
# the same way as in the panel so you can copy each one to its section.
# =============================================================================


# =============================================================================
# 1) ENVIRONMENT SETTINGS  (runtime)
# =============================================================================
# Must be exactly development | production | test.
NODE_ENV=production
# HTTP port the API listens on.
PORT=3100

# Pooled Postgres connection (port 6543, needs ?pgbouncer=true). Consumed by
# the shared @vaquita/db Prisma client.
DATABASE_URL=postgresql://postgres.<tenant>:<password>@<host>:6543/postgres?pgbouncer=true

# Admin endpoints require this exact value in the `x-admin-secret` header.
# Min 16 chars, never empty.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=

# Pino log level: fatal | error | warn | info | debug | trace.
LOG_LEVEL=info

# --- Observability (Grafana Cloud) -------------------------------------------
# 'true' registers GET /api/v1/metrics (Prometheus exposition). This endpoint
# is PRIVATE-ONLY — Grafana Alloy scrapes it over the internal network; it is
# never exposed publicly. Values: true | false.
OBSERVABILITY_METRICS_ENABLED=false
# Refresh interval (ms, integer) of the product metrics collector
# (TVL/deposits/badges). Only runs when metrics are enabled.
OBSERVABILITY_METRICS_REFRESH_MS=60000

# Realtime (Ably) FULL key (appId.keyId:secret). Server-only: the web/admin
# clients request short-lived tokens from GET /api/v1/ably/token.
ABLY_KEY=

# ---- Stellar / badges -------------------------------------------------------
# Mainnet | Testnet. The network passphrase the API uses to build and verify
# transactions is derived from this.
STELLAR_NETWORK=Testnet

# Soroban RPC endpoints, one per network. Badge reads use the one matching
# STELLAR_NETWORK; APY always uses the mainnet one.
STELLAR_MAINNET_SOROBAN_RPC_URL=https://mainnet.sorobanrpc.com
STELLAR_TESTNET_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Badge signing key: 64-char hex (32-byte raw Ed25519 seed). The whole badge
# mint flow depends on it.
# Generate: openssl rand -hex 32
BADGE_SIGNING_SEED=

# Stellar mainnet launch timestamp (Unix ms, integer). Opens the 7-day window
# of the D2 "Mainnet Pioneer" badge.
# Generate: node -e "console.log(Date.parse('2026-06-01T00:00:00Z'))"
MAINNET_LAUNCH_TIMESTAMP=

# ---- Wallet-session auth ----------------------------------------------------
# Mutating /profile endpoints require a session token obtained by signing a
# challenge transaction with the user's wallet (POST /auth/challenge +
# /auth/verify). The challenge uses the USER's account as tx.source (Pollar's
# custodial signer requires that) with sequence 0, so it can never execute
# on-chain; one-shot server-side nonces stop forgeries and replays.
#
# HMAC secret for session tokens (min 32 chars). Must be a fixed value shared
# by every PM2 cluster instance; otherwise each instance signs with a
# different key and tokens 401 across instances.
# Generate: openssl rand -hex 32
AUTH_SESSION_SECRET=
# Domain label used as the challenge's manage_data key.
AUTH_HOME_DOMAIN=vaquita.app
# 'false' only LOGS missing/invalid wallet sessions instead of rejecting
# (escape hatch, e.g. while confirming every wallet type can sign challenges).
# Values: true | false.
WALLET_AUTH_ENFORCE=true

# ---- DeFindex ---------------------------------------------------------------
# DeFindex API for the protocol APY. Without a vault address in the token
# config, the APY falls back to Blend-only even when these are set.
DEFINDEX_API_HOST=https://api.defindex.io
DEFINDEX_API_KEY=

# ---- Content moderation (OpenAI) --------------------------------------------
# Checks every feedback/bug report — text and screenshots — before it reaches
# the public board. Optional: with no key, nothing is auto-approved and every
# report waits for an admin in the Feedback screen, which is the safe failure.
OPENAI_API_KEY=

# ---- CCTP bridge ------------------------------------------------------------
# Circle Iris endpoints (attestations), one per environment; the bridge routes
# pick one by the SOURCE network of each transfer. The confirmation worker is
# a separate service: apps/bridge-worker.
CIRCLE_CCTP_IRIS_MAINNET_BASE_URL=https://iris-api.circle.com
CIRCLE_CCTP_IRIS_TESTNET_BASE_URL=https://iris-api-sandbox.circle.com

# ---- Web push (VAPID) --------------------------------------------------------
# Keypair that signs every push message. The public half is also baked into the
# web bundle as NEXT_PUBLIC_VAPID_PUBLIC_KEY (apps/web, build-time); a mismatch
# between the two makes every push service reject the delivery.
# Optional: with either key empty the sender warns once and reports every send
# as skipped, so the notification endpoints answer without pushing anything.
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URI carried in the VAPID JWT (mailto: or https:), used by push
# services to reach whoever operates the sender. Defaults to
# mailto:hello@vaquita.fi when unset.
VAPID_SUBJECT=mailto:protocolvaquita@gmail.com

# ---- Deploy webhook ----------------------------------------------------------
# Read by notify.sh; when empty, notifications are skipped. Same values as the
# build-time secrets in section 3.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=

# ---- Reconciliation CLI (pnpm reconcile:*) -----------------------------------
# Only for the CLI apps/api/src/scripts/reconcile.ts — the API service does
# not read these. The RPC comes from STELLAR_*_SOROBAN_RPC_URL according to
# the inferred network.
# RECONCILIATION_NETWORK=        (mainnet | testnet; default: script suffix)
# RECONCILIATION_JOB=            (default: <network>-pool-events)
# RECONCILIATION_OVERLAP_LEDGERS=20
# RECONCILIATION_FALLBACK_LOOKBACK_LEDGERS=500
# RECONCILIATION_ARTIFACT_PATH=  (empty = no artifact written)
# VAQUITA_POOL_CONTRACT_IDS=     (comma-separated list; default: project config)


# =============================================================================
# 2) BUILD-TIME ARGUMENTS
# The Dockerfile receives them as ARG. Set them in the panel, NOT in this file.
# =============================================================================
# DEPLOY_ID                  (groups webhook events; default: git SHA)
# WEBHOOK_SOURCE             (the Dockerfile sets it to "apps/api")


# =============================================================================
# 3) BUILD-TIME SECRETS
# Sensitive info, only available during build. The Dockerfile mounts them as
# --mount=type=secret,id=<name>
# =============================================================================
# notification_webhook_url=
# notification_webhook_token=
