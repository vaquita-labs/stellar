# =============================================================================
# @vaquita/web — Variables de entorno
# =============================================================================
# Uso local: copia este archivo a `.env` y rellena los valores.
#
# En Dokploy las variables se reparten en 3 secciones. Abajo están agrupadas
# igual que en el panel para que las copies a la sección correspondiente.
#
# TODAS las variables son REQUERIDAS: se validan con zod en
# src/core-ui/config/clientEnv.ts y el build falla si falta alguna.
#
# NOTA: el archivo `env.example` (sin punto) de esta carpeta es distinto:
# contiene parámetros para los scripts de testing de contratos Stellar, no del
# deploy de la app.
# =============================================================================


# =============================================================================
# 1) ENVIRONMENT SETTINGS  (runtime)
# =============================================================================
NODE_ENV=production

# ---- Deploy webhook ----------------------------------------------------------
# Same values as the build-time secrets in section 3. Read by notify.sh (deploy
# notification flow); when empty, notifications are skipped.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=


# =============================================================================
# 2) BUILD-TIME ARGUMENTS
# Las NEXT_PUBLIC_* se hornean en el build → SIEMPRE van aquí (no en Environment
# Settings). El Dockerfile las recibe como ARG; todas son requeridas y NO pueden
# ir vacías (si no, el build falla en el prerender).
# Ably NO necesita key en el cliente: usa token-auth contra
# `GET ${NEXT_PUBLIC_SERVICES_URL}/api/v1/ably/token` (la key vive en la API).
# =============================================================================
# Base URL of the API service the web client calls.
NEXT_PUBLIC_SERVICES_URL=https://api.vaquita.fi
# Soroban RPC endpoints used by the client SDK, one per network. The active one
# is picked by the network derived from the Pollar key, so a mainnet wallet can
# never hit a testnet RPC (or vice versa).
NEXT_PUBLIC_STELLAR_MAINNET_SOROBAN_RPC_URL=https://mainnet.sorobanrpc.com
NEXT_PUBLIC_STELLAR_TESTNET_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Pollar publishable key (client-side). La red Stellar ACTIVA de toda la app se
# deriva de su prefijo: pub_mainnet_… → mainnet, pub_testnet_… → testnet (zod
# rechaza cualquier otro formato).
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=
# --- Direct-to-Blend deposit ---------------------------------------------------
# Blend V2: pool, USDC (reserva) que ese pool acepta y su emisor, para la red
# ACTIVA (la del prefijo de la Pollar key). Cambiar mainnet<->testnet es apuntar
# estas cuatro al lado correcto.
#   mainnet pool:   CAJJZSGMMM3PD7N33TAPHGBUGTB43OC73HVIK2L2G6BNGGGYOSSYBXBD
#   testnet pool:   CCEBVDYM32YNYCVNRXQKDFFPISJJCV557CDZEIRBEE4NCV4KHPQ44HGF
#   mainnet USDC:   CCW67TSZV3SSS2HXMBQ5JFGCKJNXKZM7UQUWUZPUTHXSTZLEO7SJMI75
#   testnet USDC:   (el USDC de reserva del pool de testnet apuntado arriba)
#   mainnet issuer: GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
#   testnet issuer: GATALTGTWIOT6BUDBCZM3Q4OQ4BO2COLOAZ7IYSKPLC2PMSOPPGF5V56
# El emisor (G-address) distingue el USDC que Blend acepta de otros "USDC" de
# emisores distintos (relevante en testnet; en mainnet hay uno solo).
NEXT_PUBLIC_BLEND_POOL_CONTRACT_ID=CAJJZSGMMM3PD7N33TAPHGBUGTB43OC73HVIK2L2G6BNGGGYOSSYBXBD
NEXT_PUBLIC_BLEND_USDC_CONTRACT_ID=CCW67TSZV3SSS2HXMBQ5JFGCKJNXKZM7UQUWUZPUTHXSTZLEO7SJMI75
NEXT_PUBLIC_BLEND_USDC_ISSUER=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
# Fee bid (stroops) para las transacciones de Blend.
NEXT_PUBLIC_BLEND_FEE_STROOPS=1000000
# SHA del commit; lo provee CI como build ARG. next.config.ts lo usa para
# estampar NEXT_PUBLIC_CARD_VERSION (cache-buster de las share cards).
# NEXT_PUBLIC_CARD_VERSION NUNCA se setea a mano.
# GIT_SHA=

# ---- Build args del webhook ---------------------------------------------------
# DEPLOY_ID    agrupa los eventos del webhook por deploy (default: SHA de git).
# WEBHOOK_SOURCE  etiqueta el origen (el Dockerfile lo fija en "apps/web").
# DEPLOY_ID=


# =============================================================================
# 3) BUILD-TIME SECRETS
# Info sensible, solo disponible en build. En el Dockerfile se montan como
# --mount=type=secret,id=<nombre>
# =============================================================================
# notification_webhook_url=
# notification_webhook_token=
