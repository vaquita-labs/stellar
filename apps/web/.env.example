# =============================================================================
# @vaquita/web — Environment variables
# =============================================================================
# Local use: copy this file to `.env` and fill in the values.
#
# In Dokploy the variables are split across 3 sections. They are grouped below
# the same way as in the panel so you can copy each one to its section.
# =============================================================================


# =============================================================================
# 1) ENVIRONMENT SETTINGS  (runtime)
# =============================================================================
NODE_ENV=production

# ---- Deploy webhook ----------------------------------------------------------
# Read by notify.sh (deploy notification flow); when empty, notifications are
# skipped. Same values as the build-time secrets in section 3.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=


# =============================================================================
# 2) BUILD-TIME ARGUMENTS
# NEXT_PUBLIC_* values are baked into the client bundle at build time → they
# ALWAYS go here (not in Environment Settings). The Dockerfile receives them as
# ARG. None may be empty except the ones marked "Optional".
# =============================================================================
# Base URL of the API service the web client calls. The browser requests
# short-lived Ably tokens from `GET ${NEXT_PUBLIC_SERVICES_URL}/api/v1/ably/token`.
NEXT_PUBLIC_SERVICES_URL=https://api.local.vaquita.fi
# Soroban RPC endpoints, one per network. The active one is picked by the
# network derived from the Pollar key.
NEXT_PUBLIC_STELLAR_MAINNET_SOROBAN_RPC_URL=https://mainnet.sorobanrpc.com
NEXT_PUBLIC_STELLAR_TESTNET_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Pollar publishable key (client-side). Must start with pub_mainnet_ or
# pub_testnet_; the prefix selects the ACTIVE Stellar network of the whole app.
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=
# Fee bid (stroops, integer) for direct-to-Blend transactions.
NEXT_PUBLIC_BLEND_FEE_STROOPS=1000000
# Cache-buster for the immutable OG/share card images. The value is part of
# every card URL, so browsers and social-network caches only refetch a card
# once this changes: bump it by hand whenever the card artwork is redesigned,
# otherwise already-shared links keep serving the old image.
NEXT_PUBLIC_CARD_VERSION=v1
# Buster for the react-query cache persisted in localStorage (key
# `vaquita-rq-cache`). Entries are only restored when their buster matches this
# value, so bumping it discards every visitor's persisted cache on their next
# load. Bump it whenever a release starts reading a field that older cached
# payloads do not carry — otherwise browsers keep serving the old shape for up
# to 24h and no network request is made to reveal it.
NEXT_PUBLIC_QUERY_CACHE_VERSION=v1
# Optional. Umami analytics website id. The tracker is self-hosted at /va.js
# (a path-based URL that ad blockers do not match) and only renders outside
# development; when this is empty no tracking script is added to the page.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Optional. Rollout flag for the passive/flexible balance: when on, savings live
# in the DeFindex vault instead of a direct-to-Blend supply, and every passive
# surface (header balance, portfolio, idle-funds prompt, invest, withdraw,
# off-ramp) reads and moves the vault position. Users still holding a legacy
# Blend position are prompted to migrate it.
# Only the exact string "true" enables it — empty or any other value keeps the
# legacy Blend path, so the vault code ships dark until this is set.
NEXT_PUBLIC_PASSIVE_VAULT_ENABLED=true
# Optional. Blocking "add the app to your home screen" screen that mobile users
# hit right after login (once per device). Only the exact string "true" shows
# it; empty or any other value means it never appears. The manual "Install app"
# row in Settings works either way.
NEXT_PUBLIC_INSTALL_PROMPT_ENABLED=

# ---- Webhook build args -------------------------------------------------------
# DEPLOY_ID groups webhook events per deploy (default: git SHA).
# WEBHOOK_SOURCE labels the origin (the Dockerfile sets it to "apps/web").
# DEPLOY_ID=


# =============================================================================
# 3) BUILD-TIME SECRETS
# Sensitive info, only available during build. The Dockerfile mounts them as
# --mount=type=secret,id=<name>
# =============================================================================
# notification_webhook_url=
# notification_webhook_token=

# Web push: clave publica VAPID (par con VAPID_PRIVATE_KEY en apps/api). Vacia = push apagado.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
