# =============================================================================
# @vaquita/web — Variables de entorno
# =============================================================================
# Uso local: copia este archivo a `.env` y rellena los valores.
#
# En Dokploy las variables se reparten en 3 secciones. Abajo están agrupadas
# igual que en el panel para que las copies a la sección correspondiente.
#
# NOTA: el archivo `env.example` (sin punto) de esta carpeta es distinto:
# contiene parámetros para los scripts de testing de contratos Stellar, no del
# deploy de la app.
# =============================================================================


# =============================================================================
# 1) ENVIRONMENT SETTINGS  (runtime)
# =============================================================================
NODE_ENV=production

# ---- Deploy webhook (optional) ----------------------------------------------
# Same values as the build-time secrets in section 3. Read by the deploy
# notification flow.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=


# =============================================================================
# 2) BUILD-TIME ARGUMENTS
# Las NEXT_PUBLIC_* se hornean en el build → SIEMPRE van aquí (no en Environment
# Settings). El Dockerfile las recibe como ARG.
# Requeridas y NO pueden ir vacías (si no, el build falla en el prerender):
#   NEXT_PUBLIC_SERVICES_URL
# Ably ya NO necesita key en el cliente: usa token-auth contra
# `GET ${NEXT_PUBLIC_SERVICES_URL}/api/v1/ably/token` (la key vive en la API).
# =============================================================================
# Base URL of the API service the web client calls. Required (build fails if empty).
NEXT_PUBLIC_SERVICES_URL=https://api.vaquita.fi
# Public Stellar network used by client-side routing and wallet configuration.
NEXT_PUBLIC_STELLAR_NETWORK=testnet
# Soroban RPC endpoint used by the client SDK. Optional: if empty, defaults are
# derived from the network (mainnet → https://mainnet.sorobanrpc.com,
# testnet → https://soroban-testnet.stellar.org).
NEXT_PUBLIC_STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# --- Direct-to-Blend deposit (deposit modal) ---------------------------------
# Network-agnostic: set these to the Blend pool of the ACTIVE network above.
# Switching mainnet<->testnet is just pointing them at the right side. If unset,
# blendDirect falls back to a built-in default per network.
#   mainnet pool: CAJJZSGMMM3PD7N33TAPHGBUGTB43OC73HVIK2L2G6BNGGGYOSSYBXBD
#   testnet pool: CCEBVDYM32YNYCVNRXQKDFFPISJJCV557CDZEIRBEE4NCV4KHPQ44HGF
NEXT_PUBLIC_BLEND_POOL_CONTRACT_ID=CCEBVDYM32YNYCVNRXQKDFFPISJJCV557CDZEIRBEE4NCV4KHPQ44HGF
# USDC reserve the pool accepts. Optional: defaults to the app's
# NEXT_PUBLIC_USDC_CONTRACT_ID on testnet, to the Blend mainnet USDC on mainnet.
#   mainnet USDC: CCW67TSZV3SSS2HXMBQ5JFGCKJNXKZM7UQUWUZPUTHXSTZLEO7SJMI75
# NEXT_PUBLIC_BLEND_USDC_CONTRACT_ID=
# NEXT_PUBLIC_BLEND_FEE_STROOPS=1000000
#
# Legacy mainnet-only names (still honored on mainnet for back-compat; prefer
# the generic names above):
# NEXT_PUBLIC_BLEND_MAINNET_POOL_CONTRACT_ID=CAJJZSGMMM3PD7N33TAPHGBUGTB43OC73HVIK2L2G6BNGGGYOSSYBXBD
# NEXT_PUBLIC_BLEND_MAINNET_USDC_CONTRACT_ID=CCW67TSZV3SSS2HXMBQ5JFGCKJNXKZM7UQUWUZPUTHXSTZLEO7SJMI75
# NEXT_PUBLIC_BLEND_MAINNET_FEE_STROOPS=1000000
# Pollar publishable key (client-side). The Stellar network is derived from its
# prefix: pub_mainnet_… → mainnet, pub_testnet_… → testnet.
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=


# =============================================================================
# 3) BUILD-TIME SECRETS
# Info sensible, solo disponible en build. En el Dockerfile se montan como
# --mount=type=secret,id=<nombre>
# =============================================================================
# notification_webhook_url=
# notification_webhook_token=
