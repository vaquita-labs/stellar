# =============================================================================
# @vaquita/web — Environment variables
# =============================================================================
# Local use: copy this file to `.env` and fill in the values.
#
# In Dokploy the variables are split across 3 sections. They are grouped below
# the same way as in the panel so you can copy each one to its section.
# =============================================================================


# =============================================================================
# 1) ENVIRONMENT SETTINGS  (runtime)
# =============================================================================
NODE_ENV=production

# ---- Deploy webhook ----------------------------------------------------------
# Read by notify.sh (deploy notification flow); when empty, notifications are
# skipped. Same values as the build-time secrets in section 3.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=


# =============================================================================
# 2) BUILD-TIME ARGUMENTS
# NEXT_PUBLIC_* values are baked into the client bundle at build time → they
# ALWAYS go here (not in Environment Settings). The Dockerfile receives them as
# ARG. None may be empty except the ones marked "Optional".
# =============================================================================
# Base URL of the API service the web client calls. The browser requests
# short-lived Ably tokens from `GET ${NEXT_PUBLIC_SERVICES_URL}/api/v1/ably/token`.
NEXT_PUBLIC_SERVICES_URL=https://api.local.vaquita.fi
# Soroban RPC endpoints, one per network. The active one is picked by the
# network derived from the Pollar key.
NEXT_PUBLIC_STELLAR_MAINNET_SOROBAN_RPC_URL=https://mainnet.sorobanrpc.com
NEXT_PUBLIC_STELLAR_TESTNET_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Pollar publishable key (client-side). Must start with pub_mainnet_ or
# pub_testnet_; the prefix selects the ACTIVE Stellar network of the whole app.
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=
# Fee bid (stroops, integer) for direct-to-Blend transactions.
NEXT_PUBLIC_BLEND_FEE_STROOPS=1000000
# Cache-buster for the immutable OG/share card images. The value is part of
# every card URL, so browsers and social-network caches only refetch a card
# once this changes: bump it by hand whenever the card artwork is redesigned,
# otherwise already-shared links keep serving the old image.
NEXT_PUBLIC_CARD_VERSION=v1
# Buster for the react-query cache persisted in localStorage (key
# `vaquita-rq-cache`). Entries are only restored when their buster matches this
# value, so bumping it discards every visitor's persisted cache on their next
# load. Bump it whenever a release starts reading a field that older cached
# payloads do not carry — otherwise browsers keep serving the old shape for up
# to 24h and no network request is made to reveal it.
NEXT_PUBLIC_QUERY_CACHE_VERSION=v1
# Optional. PostHog project API key (phc_...). Analytics needs BOTH this and
# NEXT_PUBLIC_POSTHOG_ENABLED=true: with either missing nothing is initialized
# and the app behaves exactly as it did before analytics existed.
NEXT_PUBLIC_POSTHOG_KEY=
# Optional. Where posthog-js sends events. Defaults to /ingest, the same-origin
# rewrite declared in next.config.ts - i.posthog.com is on every ad-blocker list
# and without the proxy a share of the events vanishes silently. Only set this
# to an absolute PostHog host in an environment that cannot rewrite.
NEXT_PUBLIC_POSTHOG_HOST=
# Optional. Off by default: only "true" turns analytics on. Separate from the
# key so an environment can be muted without clearing its key.
NEXT_PUBLIC_POSTHOG_ENABLED=
# Optional. Session replay. Off by default and separate from the analytics flag
# on purpose: do NOT turn it on until /privacy states that sessions are
# recorded, by whom and for how long - the app has no consent mechanism, and the
# DOM carries the balance, the portfolio value, the full wallet address on the
# Receive screen and the QR of a real bank payment. All rendered text is masked
# and both QR containers are blocked, but that is defence in depth, not consent.
NEXT_PUBLIC_SESSION_REPLAY_ENABLED=
# Optional. Rollout flag for the passive/flexible balance: when on, savings live
# in the DeFindex vault instead of a direct-to-Blend supply, and every passive
# surface (header balance, portfolio, idle-funds prompt, invest, withdraw,
# off-ramp) reads and moves the vault position. Users still holding a legacy
# Blend position are prompted to migrate it.
# Only the exact string "true" enables it — empty or any other value keeps the
# legacy Blend path, so the vault code ships dark until this is set.
NEXT_PUBLIC_PASSIVE_VAULT_ENABLED=true
# Optional. Blocking "add the app to your home screen" screen that mobile users
# hit right after login (once per device). Only the exact string "true" shows
# it; empty or any other value means it never appears. The manual "Install app"
# row in Settings works either way.
NEXT_PUBLIC_INSTALL_PROMPT_ENABLED=
# Optional. VAPID public key for web push; pairs with VAPID_PRIVATE_KEY in
# apps/api and both halves must come from the same keypair or every push is
# rejected by the browser's push service. Empty disables the whole subscription
# UI (the nudge and the Settings toggle never render), so push ships dark until
# the key is set. Being build-time, rotating the keypair needs a rebuild, not a
# restart.
# Generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Optional. Mailbox behind the "Email" card in the Concierge screen (the card
# opens a mailto: to it). Empty falls back to the default in
# src/core-ui/config/featureFlags.ts, so the card always has a destination —
# set this to point support at a real shared inbox instead.
NEXT_PUBLIC_SUPPORT_EMAIL=

# There is deliberately NO flag for the Bolivia (BOB) ramps. Both corridors are
# enabled by the provider, not by us: the app asks Pollar's /ramps/countries at
# runtime and leaves Bolivia greyed out as "coming soon" in the country picker
# whenever it is not listed — which is what testnet does, since the corridor
# only exists on mainnet. NEXT_PUBLIC_BOLIVIA_ONRAMP_ENABLED and
# NEXT_PUBLIC_BOLIVIA_OFFRAMP_ENABLED used to answer this and were removed: a
# build-time flag can only state what we believed on deploy day. Do not add
# them back. See src/networks/pollar/rampCountries.ts.

# ---- Testnet integration tests (`pnpm test:integration`, never at runtime) ----
# Secret key of a Stellar TESTNET account that signs the suite's deposit,
# withdraw and mint_badge transactions against the deployed contracts. When
# empty every integration test skips, so the suite is green offline. The
# account is created via friendbot and topped up with the pool's USDC from the
# Blend testnet faucet on first run; a key that cannot be funded that way needs
# the token sent to it by hand. Never a mainnet key, never committed.
INTEGRATION_STELLAR_SECRET=
# Optional. Testnet contract ids the suite targets; the defaults in
# src/networks/stellar/__integration__/testnet.ts are the current deployments.
# Override after a redeploy or a testnet reset.
INTEGRATION_POOL_CONTRACT_ID=
INTEGRATION_BADGES_CONTRACT_ID=
INTEGRATION_TOKEN_CONTRACT_ID=
# Optional. Path of the JUnit XML report the integration run writes (CI uploads
# it as an artifact); empty keeps the console reporter only.
INTEGRATION_JUNIT_FILE=

# ---- Webhook build args -------------------------------------------------------
# DEPLOY_ID groups webhook events per deploy (default: git SHA).
# WEBHOOK_SOURCE labels the origin (the Dockerfile sets it to "apps/web").
# DEPLOY_ID=


# =============================================================================
# END-TO-END SUITE (apps/web/e2e — local runs and .github/workflows/e2e.yml)
# Never set these in Dokploy or the Dockerfile. See apps/web/e2e/README.md.
# =============================================================================
# Secret key (S…) of a funded Stellar TESTNET account the specs sign with.
# E2E_STELLAR_SECRET=
# Optional overrides forwarded to the app under test as NEXT_PUBLIC_SERVICES_URL
# and NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY (must be a pub_testnet_ key).
# E2E_SERVICES_URL=https://api.testnet.development.vaquita.fi
# E2E_POLLAR_PUBLISHABLE_KEY=
# Minimum pass rate (percent) scripts/e2e-pass-rate.mjs enforces. Default 95.
# E2E_MIN_PASS_RATE=95


# =============================================================================
# 3) BUILD-TIME SECRETS
# Sensitive info, only available during build. The Dockerfile mounts them as
# --mount=type=secret,id=<name>
# =============================================================================
# notification_webhook_url=
# notification_webhook_token=
