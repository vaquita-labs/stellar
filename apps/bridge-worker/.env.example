# =============================================================================
# @vaquita/bridge-worker — Environment variables
# =============================================================================
# Local use: copy this file to `.env` and fill in the values.
# =============================================================================

# Must be exactly development | production | test.
NODE_ENV=production

# Pooled Postgres connection (port 6543, needs ?pgbouncer=true). Consumed by
# the shared @vaquita/db Prisma client. Use the SAME value as apps/api.
DATABASE_URL=postgresql://postgres.<tenant>:<password>@<host>:6543/postgres?pgbouncer=true

# Soroban RPC endpoints, one per network. The worker picks one per destination
# network of each transfer.
STELLAR_MAINNET_SOROBAN_RPC_URL=https://soroban-rpc.mainnet.stellar.org:443
STELLAR_TESTNET_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Circle Iris endpoints (CCTP attestations), one per environment; picked by
# the SOURCE network of each transfer.
CIRCLE_CCTP_IRIS_MAINNET_BASE_URL=https://iris-api.circle.com
CIRCLE_CCTP_IRIS_TESTNET_BASE_URL=https://iris-api-sandbox.circle.com

# Stellar relayer secret key used to submit the permissionless CCTP
# `mint_and_forward` destination transactions. Server-only.
BRIDGE_STELLAR_RELAYER_SECRET=
# Fee bid (stroops, integer) and timeout (seconds, integer) of the relayed
# Stellar transactions.
BRIDGE_STELLAR_RELAYER_FEE_STROOPS=1000000
BRIDGE_STELLAR_RELAYER_TIMEOUT_SECONDS=60

# 'true' runs a single batch and exits (same as --once); 'false' loops.
BRIDGE_CONFIRMATION_ONCE=false
# Worker loop cadence (ms, positive integer).
BRIDGE_CONFIRMATION_INTERVAL_MS=60000
# Max pending rows claimed per batch (positive integer).
BRIDGE_CONFIRMATION_BATCH_SIZE=20
# How long one worker claims a row before another may retry it (ms). Must
# exceed the per-batch processing time.
BRIDGE_CONFIRMATION_LEASE_MS=60000
# Max age of a pending attestation before it is moved to needs_review instead
# of polling forever (ms; 24 h).
BRIDGE_CONFIRMATION_STALE_AFTER_MS=86400000

# Network passphrase override for relayed transactions. LEAVE UNSET unless you
# know exactly why: a wrong value makes every relay hash against the wrong
# network. Empty = derived from the transfer's destination network.
# STELLAR_NETWORK_PASSPHRASE=
