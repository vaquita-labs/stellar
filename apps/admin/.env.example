# =============================================================================
# @vaquita/admin — Variables de entorno
# =============================================================================
# Uso local: copia este archivo a `.env` y rellena los valores.
#
# En Dokploy las variables se reparten en 3 secciones. Abajo están agrupadas
# igual que en el panel para que las copies a la sección correspondiente.
#
# TODAS las variables son REQUERIDAS. Las de servidor se validan con zod en
# src/core-ui/config/serverEnv.ts (lazy: en el primer request, no en el build);
# las NEXT_PUBLIC_* en src/core-ui/config/clientEnv.ts (en el build).
# =============================================================================


# =============================================================================
# 1) ENVIRONMENT SETTINGS  (runtime)
# =============================================================================
NODE_ENV=production

# Pooled Postgres connection (port 6543, needs ?pgbouncer=true). The
# server-side admin routes (config, tokens, rewards, achievements,
# contract-events) query Postgres directly via the shared @vaquita/db Prisma
# client. Use the SAME value as apps/api.
DATABASE_URL=postgresql://postgres.<tenant>:<password>@<host>:6543/postgres?pgbouncer=true

# Server-side secret that gates the local admin API routes (config, tokens,
# rewards, achievements, contract-events): requests must echo it in the
# `x-admin-secret` header. Min 16 chars, nunca vacío — no hay open mode.
# SERVER-ONLY (no NEXT_PUBLIC_ prefix). Use the SAME value as apps/api and as
# NEXT_PUBLIC_ADMIN_SECRET below.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=

# Passcode that gates EVERY admin route (enforced by src/middleware.ts). Users
# must enter it at /login to obtain an httpOnly session cookie. Min 8 chars,
# nunca vacío — el gate siempre está activo. SERVER-ONLY (no NEXT_PUBLIC_
# prefix) → never shipped to the browser.
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ADMIN_PASSCODE=

# Soroban RPC endpoints used by the admin routes that read the chain
# (contract-events scan, tokens/onchain). SERVER-ONLY, runtime-only (no
# necesitan estar en el build). The mainnet one is used when the Config network
# passphrase is PUBLIC, otherwise the testnet one. Note RPC only retains a few
# days of events, so old date ranges return a warning and are clamped.
STELLAR_MAINNET_SOROBAN_RPC_URL=https://soroban-rpc.mainnet.stellar.org:443
STELLAR_TESTNET_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# ---- Deploy webhook ----------------------------------------------------------
# Leídas por notify.sh (shell, no zod): vacías = las notificaciones se saltan.
# Same values as the build-time secrets in section 3.
NOTIFICATION_WEBHOOK_URL=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NOTIFICATION_WEBHOOK_TOKEN=


# =============================================================================
# 2) BUILD-TIME ARGUMENTS
# Las NEXT_PUBLIC_* se hornean en el build → SIEMPRE van aquí (no en Environment
# Settings). El Dockerfile las recibe como ARG; ambas son requeridas y NO pueden
# ir vacías (si no, el build falla en el prerender).
# Ably NO necesita key en el cliente: usa token-auth contra
# `GET ${NEXT_PUBLIC_SERVICES_URL}/api/v1/ably/admin-token` (gated por el
# admin-secret; la key de Ably vive en la API).
# Otros build args: DEPLOY_ID (agrupa eventos del webhook; default: SHA de git)
# y WEBHOOK_SOURCE (el Dockerfile lo fija en "apps/admin").
# =============================================================================
NEXT_PUBLIC_SERVICES_URL=https://api.vaquita.fi
# Sent as `x-admin-secret` on admin write calls (badge CRUD) and on the Ably
# token request. Must match the API's ADMIN_SECRET. OJO: las NEXT_PUBLIC_ llegan
# al browser — aceptable solo porque el admin vive detrás del passcode gate y
# de control de acceso de red.
NEXT_PUBLIC_ADMIN_SECRET=


# =============================================================================
# 3) BUILD-TIME SECRETS
# Info sensible, solo disponible en build. En el Dockerfile se montan como
# --mount=type=secret,id=<nombre>
# =============================================================================
# notification_webhook_url=
# notification_webhook_token=
