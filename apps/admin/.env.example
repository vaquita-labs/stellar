# =============================================================================
# @vaquita/admin — Environment variables
# =============================================================================
# Local use: copy this file to `.env` and fill in the values.
#
# In Dokploy the variables are split across 3 sections. They are grouped below
# the same way as in the panel so you can copy each one to its section.
# =============================================================================


# =============================================================================
# 1) ENVIRONMENT SETTINGS  (runtime)
# =============================================================================
NODE_ENV=production

# Pooled Postgres connection (port 6543, needs ?pgbouncer=true). The
# server-side admin routes (config, tokens, rewards, achievements,
# contract-events) query Postgres directly via the shared @vaquita/db Prisma
# client. Use the SAME value as apps/api.
DATABASE_URL=postgresql://postgres.<tenant>:<password>@<host>:6543/postgres?pgbouncer=true

# Server-side secret that gates the local admin API routes (config, tokens,
# rewards, achievements, contract-events): requests must echo it in the
# `x-admin-secret` header. Min 16 chars, never empty. SERVER-ONLY (no
# NEXT_PUBLIC_ prefix). Use the SAME value as apps/api and as
# NEXT_PUBLIC_ADMIN_SECRET below.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=

# Passcode that gates EVERY admin route (enforced by src/middleware.ts). Users
# must enter it at /login to obtain an httpOnly session cookie. Min 8 chars,
# never empty. SERVER-ONLY (no NEXT_PUBLIC_ prefix) → never shipped to the
# browser.
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ADMIN_PASSCODE=

# Soroban RPC endpoints used by the admin routes that read the chain
# (contract-events scan, tokens/onchain). SERVER-ONLY, runtime-only (not needed
# at build time). The mainnet one is used when the Config network passphrase is
# PUBLIC, otherwise the testnet one. Note RPC only retains a few days of
# events, so old date ranges return a warning and are clamped.
STELLAR_MAINNET_SOROBAN_RPC_URL=https://mainnet.sorobanrpc.com
STELLAR_TESTNET_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# ---- Deploy webhook ----------------------------------------------------------
# Read by notify.sh; when empty, notifications are skipped. Same values as the
# build-time secrets in section 3.
NOTIFICATION_WEBHOOK_URL=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NOTIFICATION_WEBHOOK_TOKEN=


# =============================================================================
# 2) BUILD-TIME ARGUMENTS
# NEXT_PUBLIC_* values are baked into the client bundle at build time → they
# ALWAYS go here (not in Environment Settings). The Dockerfile receives them as
# ARG. Neither may be empty.
# Other build args: DEPLOY_ID (groups webhook events per deploy; default: git
# SHA) and WEBHOOK_SOURCE (the Dockerfile sets it to "apps/admin").
# =============================================================================
# Base URL of the API service. The admin client requests short-lived Ably
# tokens from `GET ${NEXT_PUBLIC_SERVICES_URL}/api/v1/ably/admin-token`
# (gated by the admin secret; the Ably key lives in the API).
NEXT_PUBLIC_SERVICES_URL=https://api.local.vaquita.fi
# Sent as `x-admin-secret` on admin write calls (badge CRUD) and on the Ably
# token request. Must match the API's ADMIN_SECRET. NOTE: NEXT_PUBLIC_ values
# reach the browser — acceptable only because the admin app lives behind the
# passcode gate and network access control.
NEXT_PUBLIC_ADMIN_SECRET=


# =============================================================================
# 3) BUILD-TIME SECRETS
# Sensitive info, only available during build. The Dockerfile mounts them as
# --mount=type=secret,id=<name>
# =============================================================================
# notification_webhook_url=
# notification_webhook_token=
