# =============================================================================
# @vaquita/metrics — Environment variables
# =============================================================================
# Local use: copy this file to `.env` and fill in the values.
#
# In Dokploy the variables are split across 3 sections; they are grouped below
# the same way. See docs/metrics-dokploy-setup.md.
# =============================================================================


# =============================================================================
# 1) ENVIRONMENT SETTINGS  (runtime)
# =============================================================================
NODE_ENV=production

# Pooled Postgres connection (port 6543, needs ?pgbouncer=true). Every metric
# is a read-only SQL query against this database via the shared @vaquita/db
# Prisma client. Use the SAME value as apps/api / apps/admin of the environment
# you want to measure.
DATABASE_URL=postgresql://postgres.<tenant>:<password>@<host>:6543/postgres?pgbouncer=true

# Passcode that gates EVERY route (enforced by src/proxy.ts). Users must enter
# it at /login to obtain an httpOnly session cookie. Min 8 chars, never empty.
# SERVER-ONLY (no NEXT_PUBLIC_ prefix) → never shipped to the browser. You can
# reuse the admin's ADMIN_PASSCODE value.
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
METRICS_PASSCODE=

# Label shown in the header so nobody confuses staging numbers with prod.
METRICS_ENV_LABEL=production

# ---- Deploy webhook ----------------------------------------------------------
# Read by notify.sh; when empty, notifications are skipped.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=


# =============================================================================
# 2) BUILD-TIME ARGUMENTS
# This app has NO NEXT_PUBLIC_* variables: everything is rendered on the
# server. Only DEPLOY_ID (set by the GitHub workflow) is used here.
# =============================================================================


# =============================================================================
# 3) BUILD-TIME SECRETS (optional, only for build notifications)
# =============================================================================
# notification_webhook_url=
# notification_webhook_token=
