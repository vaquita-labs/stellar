// Prisma schema for the Vaquita Postgres database (hosted on Supabase).
//
// SOURCE OF TRUTH: the SQL migrations in apps/supabase/migrations.
//
// ⚠️ DESIGN DRAFT: this schema is intentionally AHEAD of the live DB. It encodes the
// target design (single-network refactor, config table, soft-delete columns,
// camelCase↔snake_case mapping). The matching SQL migrations are to be written in a
// later step. Until then:
//   - DO NOT run `prisma db pull` — it would revert this design to the current DB.
//   - The generated client is ahead of the database; do not rely on it at runtime yet.
//
// Naming convention: models and fields are camelCase in code, mapped to the real
// snake_case DB names with @map / @@map. Model names are PascalCase singular (their
// Prisma Client accessors are auto-camelCased, e.g. `prisma.profileAchievement`).

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Achievement {
  id            BigInt    @id @default(autoincrement())
  key           String    @unique
  name          String
  description   String
  tier          String
  code          String?   @unique(map: "achievements_code_unique", where: raw("(code IS NOT NULL)"))
  coinReward    Int       @default(0) @map("coin_reward")
  // XP credited on claim, ledgered to `profiles_rewards` (reward `experience`)
  // the same way coins are — the admin value only affects claims from then on.
  xpReward      Int       @default(0) @map("xp_reward")
  hidden        Boolean   @default(false)
  refreshPolicy String    @default("auto") @map("refresh_policy")
  cycleScoped   Boolean   @default(false) @map("cycle_scoped")
  // Configurable badge catalog + rules engine (migration 20260529_achievement_rules).
  unlockType    String    @default("rule") @map("unlock_type")
  rule          Json?
  icon          String?
  accent        String?
  displayOrder  Int       @default(0) @map("display_order")
  enabled       Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  profileAchievements ProfileAchievement[]
  profileUnlocks      ProfileAchievementUnlock[]

  @@map("achievements")
}

model BadgeClaim {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walletAddress   String    @map("wallet_address")
  badgeType       String    @map("badge_type")
  cycleId         Int       @default(0) @map("cycle_id")
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  signature       String
  transactionHash String?   @map("transaction_hash")
  supersededAt    DateTime? @map("superseded_at") @db.Timestamptz(6)
  confirmedAt     DateTime? @map("confirmed_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([walletAddress, badgeType, cycleId], map: "idx_badge_claims_active", where: raw("(superseded_at IS NULL)"))
  @@index([walletAddress, badgeType], map: "idx_badge_claims_confirmed", where: raw("(confirmed_at IS NOT NULL)"))
  @@map("badge_claims")
}

model Deposit {
  id                     Int       @id @default(autoincrement())
  walletAddress          String    @map("wallet_address") @db.VarChar(100)
  tokenId                Int       @map("token_id")
  amount                 Decimal   @db.Decimal
  status                 String    @default("initiated") @db.VarChar(20)
  transactionHash        String?   @map("transaction_hash") @db.VarChar(100)
  transactionEventRaw    String?   @map("transaction_event_raw")
  depositIdHex           String?   @map("deposit_id_hex")
  nonce                  BigInt?   @map("nonce")
  lockPeriod             BigInt?   @map("lock_period")
  vaquitaContractAddress String?   @map("vaquita_contract_address")
  confirmedAt            DateTime? @map("confirmed_at") @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz(6)

  token       Token        @relation(fields: [tokenId], references: [id], onUpdate: NoAction)
  withdrawals Withdrawal[]

  @@index([status], map: "idx_deposits_status")
  @@index([tokenId], map: "idx_deposits_token_id")
  @@index([walletAddress], map: "idx_deposits_wallet_address")
  @@map("deposits")
}

/// Compra de USDC con moneda local (on-ramp). Existe por una sola razón: la API
/// de ramps no tiene endpoint de listado, así que el `providerTxId` que devuelve
/// la creación es el ÚNICO handle sobre una compra en curso. Perderlo deja al
/// usuario pagado y sin pantalla a la que volver, y guardarlo sólo en el
/// navegador no sobrevive ni a cambiar de dispositivo ni a la limpieza de
/// storage de Safari móvil.
///
/// `status`: pending | paid | settled | expired | failed | cancelled. Los tres
/// finales sin acreditar se distinguen porque cuentan cosas distintas: `expired`
/// venció el QR sin que nadie lo pagara, `failed` la rechazó el proveedor y
/// `cancelled` la abandonó el usuario a mano con el código todavía vivo.
model OnrampPurchase {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walletAddress String    @map("wallet_address") @db.VarChar(128)
  providerTxId  String    @map("provider_tx_id") @db.VarChar(128)
  provider      String    @db.VarChar(64)
  country       String    @db.Char(2)
  amountFiat    String    @map("amount_fiat") @db.VarChar(80)
  currency      String    @db.VarChar(8)
  status        String    @default("pending") @db.VarChar(32)
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz(6)
  lastPolledAt  DateTime? @map("last_polled_at") @db.Timestamptz(6)
  errorReason   String?   @map("error_reason")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@unique([provider, providerTxId], map: "onramp_purchases_provider_tx_unique")
  @@index([walletAddress, updatedAt], map: "idx_onramp_purchases_wallet_pending")
  @@map("onramp_purchases")
}

/// Retiro a moneda local (off-ramp). Espejo de {@link OnrampPurchase} y, como
/// ella, existe porque la API de ramps no tiene endpoint de listado: el
/// `providerTxId` es el único handle sobre un retiro en curso.
///
/// La diferencia está en CUÁNDO se abre la fila. El USDC sale del vault en el
/// primer paso, antes de que el proveedor sepa nada, así que la fila se crea
/// ANTES de ese retiro y `providerTxId`/`provider` quedan en null hasta que la
/// creación responde. Una fila que nunca los tuvo es un retiro que movió plata
/// del usuario y no llegó a la rampa — el caso que esta tabla existe para no
/// perder.
///
/// `step`: funds | create | payout (los mismos del stepper del modal).
/// `status`: pending | settled | failed | abandoned.
///
/// Lo reporta el cliente: es rastro para soporte, no un libro contable.
model OfframpWithdrawal {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walletAddress     String    @map("wallet_address") @db.VarChar(128)
  providerTxId      String?   @map("provider_tx_id") @db.VarChar(128)
  provider          String?   @db.VarChar(64)
  country           String    @db.Char(2)
  rail              String?   @db.VarChar(16)
  amountFiat        String    @map("amount_fiat") @db.VarChar(80)
  currency          String    @db.VarChar(8)
  usdcAmount        String?   @map("usdc_amount") @db.VarChar(80)
  vaultWithdrawHash String?   @map("vault_withdraw_hash") @db.VarChar(80)
  paymentHash       String?   @map("payment_hash") @db.VarChar(80)
  step              String    @default("funds") @db.VarChar(16)
  status            String    @default("pending") @db.VarChar(32)
  errorReason       String?   @map("error_reason")
  lastPolledAt      DateTime? @map("last_polled_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@unique([provider, providerTxId], map: "offramp_withdrawals_provider_tx_unique")
  @@index([walletAddress, updatedAt], map: "idx_offramp_withdrawals_wallet_pending")
  @@map("offramp_withdrawals")
}

model BridgeTransfer {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  direction            String    @db.VarChar(32)
  sourceNetwork        String    @map("source_network") @db.VarChar(40)
  destinationNetwork   String    @map("destination_network") @db.VarChar(40)
  sourceWallet         String    @map("source_wallet") @db.VarChar(128)
  destinationWallet    String    @map("destination_wallet") @db.VarChar(128)
  amount               String    @db.VarChar(80)
  amountRaw            String    @map("amount_raw") @db.VarChar(80)
  status               String    @default("source_awaiting_signature") @db.VarChar(40)
  sourceTxHash         String?   @unique(map: "bridge_transfers_source_tx_unique") @map("source_tx_hash") @db.VarChar(128)
  destinationTxHash    String?   @map("destination_tx_hash") @db.VarChar(128)
  messageHash          String?   @map("message_hash") @db.VarChar(128)
  cctpMessage          String?   @map("cctp_message")
  cctpAttestation      String?   @map("cctp_attestation")
  errorReason          String?   @map("error_reason")
  retryCount           Int       @default(0) @map("retry_count")
  lastPolledAt         DateTime? @map("last_polled_at") @db.Timestamptz(6)
  processingLeaseUntil DateTime? @map("processing_lease_until") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([sourceWallet], map: "idx_bridge_transfers_source_wallet")
  @@index([destinationWallet], map: "idx_bridge_transfers_destination_wallet")
  @@index([status, updatedAt], map: "idx_bridge_transfers_status_updated")
  @@map("bridge_transfers")
}

/// Payout wallet the user saved for the withdraw flow, so they don't have to
/// paste an exchange/self-custody address every time. `label` is user-chosen
/// free text ("Binance Solana usdc"); `network` is one of the supported network
/// keys (see CCTP_NETWORKS in @vaquita/shared). Soft-deleted so a removed entry
/// never resurrects a stale address, while past withdrawals can still resolve it.
model SavedWallet {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId Int       @map("profile_id")
  label     String    @db.VarChar(60)
  address   String    @db.VarChar(128)
  memo      String?   @db.VarChar(64)
  network   String    @db.VarChar(40)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([profileId, address, network], map: "saved_wallets_unique_address")
  @@index([profileId], map: "idx_saved_wallets_profile_id")
  @@map("saved_wallets")
}

/// Bank account the user saved for the fiat off-ramp, the mirror of
/// {@link SavedWallet} on the other side of the withdraw flow: it exists so
/// nobody retypes their ID number and account number on every withdrawal.
///
/// `fields` is `{ [field.key]: value }` exactly as `quote.requiredFields`
/// describes it — the provider decides which fields a corridor asks for, so
/// adding one must not need a migration. `country`/`currency`/`rail` stay as
/// columns because they are what filters the list for the current corridor.
///
/// CAREFUL: `fields` holds real personal data (full name, tax ID, e-mail,
/// account number). It is stored as typed, unencrypted, and is only ever read
/// back to its own owner — the profile always comes from the session token.
model SavedBankAccount {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId Int       @map("profile_id")
  label     String    @db.VarChar(60)
  country   String    @db.Char(2)
  currency  String    @db.VarChar(8)
  rail      String?   @db.VarChar(16)
  fields    Json      @default("{}")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([profileId], map: "idx_saved_bank_accounts_profile_id")
  @@map("saved_bank_accounts")
}

/// A bug report or a piece of feedback sent from inside the app (Concierge →
/// "Report a bug" / "Send feedback"). Both kinds share one shape — a short
/// title and a details body — because they are triaged differently, not filled
/// in differently.
///
/// `locale`, `userAgent` and `appPath` are filled in by the server, never by
/// the client: they are the cheap stand-in for the screenshot upload that was
/// deliberately deferred. `walletAddress` is denormalized (like
/// LegalAcceptance) so a report survives the deletion of the profile that
/// filed it.
///
/// `kind` and `status` are constrained by CHECKs that live in
/// packages/db/sql/feedback_posts_enums.sql — Prisma cannot express them and
/// `db push` would drop them.
model FeedbackPost {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId     Int?      @map("profile_id")
  walletAddress String    @map("wallet_address") @db.VarChar(64)
  /// 'bug' | 'feedback'
  kind          String    @db.VarChar(10)
  title         String    @db.VarChar(120)
  details       String    @default("")
  /// 'open' | 'planned' | 'in_progress' | 'done' | 'closed'
  status        String    @default("open") @db.VarChar(20)
  locale        String?   @db.VarChar(8)
  userAgent     String?   @map("user_agent")
  appPath       String?   @map("app_path") @db.VarChar(200)
  /// Denormalized `feedback_votes` count. The board's default order is by votes,
  /// and an aggregate over the join cannot be indexed; written in the same
  /// transaction as the vote.
  voteCount     Int       @default(0) @map("vote_count")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  profile     Profile?              @relation(fields: [profileId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  attachments FeedbackAttachment[]
  votes       FeedbackVote[]

  @@index([kind, status, createdAt(sort: Desc)], map: "idx_feedback_posts_triage")
  @@index([profileId, createdAt(sort: Desc)], map: "idx_feedback_posts_profile_created")
  @@index([kind, voteCount(sort: Desc), createdAt(sort: Desc)], map: "idx_feedback_posts_board")
  @@map("feedback_posts")
}

/// A screenshot attached to a report. The bytes live in Postgres because the
/// project has no object store: the client downscales and recompresses before
/// upload and the API caps each file at 2 MB, which keeps that honest. Moving to
/// a bucket later only changes where `data` comes from.
model FeedbackAttachment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId      String   @map("post_id") @db.Uuid
  /// 'image/png' | 'image/jpeg' | 'image/webp' — enforced by a CHECK constraint.
  contentType String   @map("content_type") @db.VarChar(40)
  byteSize    Int      @map("byte_size")
  data        Bytes
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  post FeedbackPost @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([postId], map: "idx_feedback_attachments_post")
  @@map("feedback_attachments")
}

/// One upvote by one profile on one report. The unique pair is what makes the
/// client's toggle idempotent: a double tap or a retried request cannot count twice.
model FeedbackVote {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  profileId Int      @map("profile_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  post    FeedbackPost @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profile Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([postId, profileId], map: "feedback_votes_post_profile_unique")
  @@index([profileId], map: "idx_feedback_votes_profile")
  @@map("feedback_votes")
}

/// A marketing campaign: one shareable code plus the default UTM parameters the
/// admin panel builds its links from.
///
/// `code` lives in a different namespace from `profiles.referralCode` (6 chars
/// from an unambiguous alphabet). Attribution resolves campaign first and user
/// referral second, so a collision would let a campaign swallow someone's
/// personal code — the admin create path validates against both, which a CHECK
/// constraint could not do across tables.
///
/// Soft-deleted rather than deleted, and the unique index on `code` is partial
/// so retiring a campaign frees its code for the next one.
model Campaign {
  id          Int       @id @default(autoincrement())
  code        String    @unique(map: "campaigns_code_unique", where: raw("(deleted_at IS NULL)")) @db.VarChar(32)
  name        String    @db.VarChar(120)

  /// Defaults for the generated link, not a filter: whatever actually arrives
  /// in the query string is stored on the profile regardless of these.
  source      String?   @db.VarChar(60)
  medium      String?   @db.VarChar(60)
  content     String?   @db.VarChar(120)
  landingPath String?   @map("landing_path") @db.VarChar(200)

  startsAt    DateTime? @map("starts_at") @db.Timestamptz(6)
  endsAt      DateTime? @map("ends_at") @db.Timestamptz(6)
  isActive    Boolean   @default(true) @map("is_active")
  notes       String?

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  profiles    Profile[]

  @@map("campaigns")
}

/// Global catalog of placeable map elements. `variants`, `prices` and
/// `free_items` are positionally-aligned CSV lists: index i of each column
/// describes the same variant (see getMapObjectsAvailableData in
/// packages/shared/src/services/profile).
model MapObject {
  id        BigInt    @id @default(autoincrement())
  type      String?   @default("")
  size      String?   @default("0,0,0")
  variants  String?   @default("")
  prices    String?   @default("")
  freeItems String?   @map("free_items")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@map("map_objects")
}

/// Singleton project configuration. Holds the data that previously lived in the
/// (now removed) `networks` table, since the app is single-network now. The
/// `order` column from `networks` was dropped — it only made sense for ordering
/// multiple networks.
model Config {
  id                    Int      @id @default(autoincrement())
  origins               String[] @default([])
  networkName           String   @map("network_name") @db.VarChar(50)
  networkPassphrase     String?  @map("network_passphrase")
  badgesContractAddress String?  @map("badges_contract_address")
  // Fixed leaderboard cycle duration in milliseconds. `null` = production
  // calendar-month cycles; a positive value enables fixed-duration test cycles.
  // Replaces the old CYCLE_DURATION_MS env var.
  cycleDurationMs       BigInt?  @map("cycle_duration_ms")
  // Gold coins granted per daily check-in. Replaces the hard-coded
  // DAILY_GOLD_COINS constant; read live from this column on every check-in.
  dailyGoldCoins        Int      @default(1) @map("daily_gold_coins")
  // Experience granted per daily check-in. Persisted to `profiles_rewards`
  // (type 'earned', the `experience` reward) on collect and summed into the
  // profile's total experience. `0` disables the check-in XP bonus.
  dailyCheckinExperience Int     @default(0) @map("daily_checkin_experience")
  // Duración (en milisegundos reales) de un día COMPLETO del reloj de juego, que
  // corre acelerado tipo Minecraft. Global para todos (se sirve vía GET
  // /api/v1/time). 1200000 = 20 min. Tope int4 (~24.8 días) de sobra.
  gameDayLengthMs       Int      @default(1200000) @map("game_day_length_ms")
  // Fiat display currencies offered in the UI (Preferences page). Each entry is
  // `{ id, label, hint? }`, e.g. `{ "id": "usd", "label": "USD", "hint": "US Dollar" }`.
  currencies            Json     @default("[]")
  // UI languages offered in the Preferences page. Each entry is
  // `{ id, label, hint? }`, e.g. `{ "id": "en", "label": "English", "hint": "United States" }`.
  languages             Json     @default("[]")
  // Reconciliation cursors and last-run summaries keyed by job and contract ID.
  // Used by mainnet chain-event repair workflows; dry runs must not advance it.
  reconciliationState    Json     @default("{}") @map("reconciliation_state")
  // Bundle version of the Privacy Policy / Terms / Risk Disclosure that users
  // must currently have accepted (date string, e.g. '2026-08-25'). Lives here
  // rather than in the frontend bundle so a material revision re-gates every
  // user without a deploy. Compared by string equality — any change re-gates.
  legalPolicyVersion     String   @default("2026-08-25") @map("legal_policy_version") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("config")
}

model Profile {
  id            Int       @id @default(autoincrement())
  walletAddress String    @unique(map: "profiles_wallet_unique") @map("wallet_address") @db.VarChar(100)
  // Public URL segment (/leaderboard/<nickname>, /explore/<nickname>) and the
  // key the share card resolves a claim by, so it is unique among live
  // profiles. The index is partial: a soft-deleted profile must not keep
  // reserving a nickname a live one could take. The charset is URL-safe
  // lowercase only, enforced in the DB by a check constraint Prisma can't
  // express (kept here so `db pull` doesn't make it look absent):
  //   profiles_nickname_format:
  //     CHECK (nickname IS NULL OR nickname ~ '^[a-z0-9_]{3,32}$')
  nickname      String?   @unique(map: "profiles_nickname_unique", where: raw("(nickname IS NOT NULL AND deleted_at IS NULL)")) @db.VarChar(50)
  fullName      String?   @map("full_name") @db.VarChar(100)
  email         String?   @db.VarChar(100)

  // The user's character avatar, as a small JSON of catalog ids + palette
  // indices (see @vaquita/avatar). We store the CHOICES, not an image: the SVG
  // is composed at render time, so re-tuning a palette or fixing a hairstyle
  // updates every profile without touching a single row. NULL means the user
  // never opened the editor — the client renders a seeded default from the
  // wallet address. Photo uploads are deliberately not supported.
  avatarConfig  Json?     @map("avatar_config") @db.JsonB

  onboardingCompleted Boolean @default(false) @map("onboarding_completed")
  tutorialCompleted   Boolean @default(false) @map("tutorial_completed")
  // The user self-identifies as crypto-savvy, so the UI can drop the
  // beginner-friendly framing and surface raw on-chain details (wallet
  // addresses, tx hashes, gas/network terms) instead of simplified copy.
  cryptoSavvy         Boolean @default(false) @map("crypto_savvy")

  // Per-user display preferences picked on the Preferences page. Each holds the
  // `id` of an option from the project config's languages/currencies lists
  // (e.g. 'en', 'usd'). NULL until the user changes it (UI falls back to the
  // first configured option).
  language      String?   @db.VarChar(10)
  currency      String?   @db.VarChar(10)

  // Per-user notification preferences picked on the Notifications page. JSON
  // object keyed by toggle id ({ push, email, deposits, streaks, friends }),
  // each a boolean. NULL until the user changes something (the API serves the
  // defaults: push/deposits/streaks on, email/friends off).
  notificationPreferences Json? @map("notification_preferences") @db.JsonB

  // Invite-a-friend graph. `referralCode` is the short string this profile
  // shares (minted lazily on first read, unique among non-NULL codes).
  // `referredById` points at the profile whose code this user signed up with —
  // set once at signup, never changed. `referrals` are the profiles this user
  // brought in; `referredBy` is the one who brought this user in.
  referralCode  String?   @unique(map: "profiles_referral_code_unique") @map("referral_code") @db.VarChar(12)
  referredById  Int?      @map("referred_by_id")

  /// Where this profile came from, captured on the first visit and written
  /// ONCE — the same never-overwrite rule as `referredById`, for the same
  /// reason: a later organic visit must not steal the conversion from the
  /// campaign that actually brought the user in.
  ///
  /// `campaignId` is the resolved campaign (what you group and count by);
  /// `attribution` is the raw first-touch blob — `utm_source/medium/campaign/
  /// content`, `referrer`, `landedAt`. Keeping the raw form alongside the
  /// resolved id is what lets us answer questions we haven't thought of yet
  /// without having thrown the data away. A user referral code does NOT land
  /// here: it still routes through `referredById`.
  campaignId    Int?      @map("campaign_id")
  attribution   Json?     @db.JsonB

  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  referredBy    Profile?  @relation("referrals", fields: [referredById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  referrals     Profile[] @relation("referrals")

  profileAchievements ProfileAchievement[]
  profileUnlocks      ProfileAchievementUnlock[]
  profileMapObjects   ProfileMapObject[]
  profileMapItems     ProfileMapItem[]
  profileRewards      ProfileReward[]
  notifications       Notification[]
  savedWallets        SavedWallet[]
  savedBankAccounts   SavedBankAccount[]
  pushSubscriptions   PushSubscription[]

  // Unidirectional follow graph. `following` are edges where this profile is the
  // follower; `followers` are edges where it is the followee.
  following Follow[] @relation("following")
  followers Follow[] @relation("followers")

  // "Friend suggestions" cards this profile dismissed / was dismissed from.
  suggestionDismissals FollowSuggestionDismissal[] @relation("suggestionDismissals")
  dismissedBy          FollowSuggestionDismissal[] @relation("dismissedBy")

  // Hearts on the 3D world: `mapLikesGiven` are maps this profile liked,
  // `mapLikesReceived` are the hearts its own map collected.
  mapLikesGiven    MapLike[] @relation("mapLikesGiven")
  mapLikesReceived MapLike[] @relation("mapLikesReceived")

  // Every time this profile accepted the legal bundle. Append-only history, not
  // a flag — see LegalAcceptance.
  legalAcceptances LegalAcceptance[]

  // Bug reports and feedback sent from the Concierge. Nullable on the other
  // side: a report outlives the profile that filed it.
  feedbackPosts FeedbackPost[]
  feedbackVotes FeedbackVote[]

  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([campaignId, createdAt], map: "idx_profiles_campaign_created")
  @@map("profiles")
}

/// A heart given to a profile's 3D world from the explore / leaderboard feed.
/// One row per (liker, owner) pair, so the count is "how many distinct vaqueros
/// liked this map" and liking twice is a no-op rather than double-counting.
model MapLike {
  id        Int      @id @default(autoincrement())
  likerId   Int      @map("liker_id")
  ownerId   Int      @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  liker Profile @relation("mapLikesGiven", fields: [likerId], references: [id], onDelete: Cascade)
  owner Profile @relation("mapLikesReceived", fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([likerId, ownerId], map: "map_likes_unique_pair")
  @@index([likerId], map: "idx_map_likes_liker")
  @@index([ownerId], map: "idx_map_likes_owner")
  @@map("map_likes")
}

/// Unidirectional follow edge: `follower` follows `followee` (Twitter-style, not mutual).
model Follow {
  id         Int      @id @default(autoincrement())
  followerId Int      @map("follower_id")
  followeeId Int      @map("followee_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  follower Profile @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  followee Profile @relation("followers", fields: [followeeId], references: [id], onDelete: Cascade)

  @@unique([followerId, followeeId], map: "follows_unique_pair")
  @@index([followerId], map: "idx_follows_follower")
  @@index([followeeId], map: "idx_follows_followee")
  @@map("follows")
}

/// "Not interested" mark on the Friend-suggestions rail: `viewer` dismissed the
/// `dismissed` profile's card, so suggestions never offer that profile to that
/// viewer again (a follow-then-unfollow can still resurface them — acceptable).
model FollowSuggestionDismissal {
  id          Int      @id @default(autoincrement())
  viewerId    Int      @map("viewer_id")
  dismissedId Int      @map("dismissed_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  viewer    Profile @relation("suggestionDismissals", fields: [viewerId], references: [id], onDelete: Cascade)
  dismissed Profile @relation("dismissedBy", fields: [dismissedId], references: [id], onDelete: Cascade)

  @@unique([viewerId, dismissedId], map: "follow_suggestion_dismissals_unique_pair")
  @@index([viewerId], map: "idx_follow_suggestion_dismissals_viewer")
  @@map("follow_suggestion_dismissals")
}

/// In-app notification feed row. `messageKey` + `params` map to frontend i18n
/// entries (notificationsCenter.messages.*); `link` is the in-app route opened
/// on tap; `dedupeKey` makes emission idempotent (unique, NULLs allowed).
model Notification {
  id         BigInt    @id @default(autoincrement())
  profileId  Int       @map("profile_id")
  type       String    @db.VarChar(20)
  messageKey String    @map("message_key") @db.VarChar(50)
  params     Json?
  link       String?   @db.VarChar(300)
  dedupeKey  String?   @unique(map: "notifications_dedupe_key_key") @map("dedupe_key") @db.VarChar(120)
  readAt     DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt(sort: Desc)], map: "idx_notifications_profile_created")
  @@map("notifications")
}

/// Web-push subscription of one device (browser/installed PWA). `endpoint` is
/// globally unique — a device belongs to exactly one wallet, and re-subscribing
/// after a login switch re-parents the row (upsert by endpoint). Rows are
/// pruned lazily when the push service returns 404/410 on send.
model PushSubscription {
  id        Int      @id @default(autoincrement())
  profileId Int      @map("profile_id")
  /// Push-service URL (FCM/APNs web push). Long — keep it TEXT.
  endpoint  String   @unique(map: "push_subscriptions_endpoint_key")
  /// Client public key (base64url) for payload encryption.
  p256dh    String   @db.VarChar(200)
  /// Client auth secret (base64url) for payload encryption.
  auth      String   @db.VarChar(100)
  userAgent String?  @map("user_agent") @db.VarChar(300)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId], map: "idx_push_subscriptions_profile")
  @@map("push_subscriptions")
}

/// Historial de envíos de notificaciones desde el admin. Cada fila es una
/// "campaña": snapshot del mensaje, la audiencia elegida y los contadores del
/// resultado del push (el in-app va aparte, vía la tabla notifications).
model PushCampaign {
  id         Int      @id @default(autoincrement())
  title      String   @db.VarChar(120)
  body       String   @db.VarChar(500)
  link       String?  @db.VarChar(300)
  /// 'all' | 'usernames'
  audience   String   @db.VarChar(20)
  /// Sólo para audience='usernames': los nicknames pedidos.
  usernames  Json?
  /// Perfiles que recibieron la notificación in-app.
  recipients Int      @default(0)
  pushSent   Int      @default(0) @map("push_sent")
  pushFailed Int      @default(0) @map("push_failed")
  pushPruned Int      @default(0) @map("push_pruned")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)], map: "idx_push_campaigns_created")
  @@map("push_campaigns")
}

model ProfileAchievement {
  id            BigInt   @id @default(autoincrement())
  profileId     Int      @map("profile_id")
  achievementId BigInt   @map("achievement_id")
  claimedAt     DateTime @default(now()) @map("claimed_at") @db.Timestamptz(6)

  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profile     Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([profileId, achievementId])
  @@index([profileId], map: "profiles_achievements_profile_idx")
  @@map("profiles_achievements")
}

/// Permanent "this profile once met the badge rule" latch. Eligibility reads
/// `liveRule(signals) OR latched`, so a signal going down (withdrawal, broken
/// streak, unfollow) can never re-lock a badge the user already earned.
model ProfileAchievementUnlock {
  id            BigInt   @id @default(autoincrement())
  profileId     Int      @map("profile_id")
  achievementId BigInt   @map("achievement_id")
  unlockedAt    DateTime @default(now()) @map("unlocked_at") @db.Timestamptz(6)

  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profile     Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([profileId, achievementId], map: "profiles_achievements_unlocks_unique")
  @@index([profileId], map: "profiles_achievements_unlocks_profile_idx")
  @@map("profiles_achievements_unlocks")
}

model ProfileMapObject {
  id        BigInt   @id @default(autoincrement())
  profileId Int?     @map("profile_id")
  objects   Json?    @db.Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile Profile? @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([profileId], map: "idx_profiles_map_objects_profile_id")
  @@map("profiles_map_objects")
}

/// Inventario de objetos de mapa del usuario: cuántas unidades de cada
/// (type, variant) posee, ganadas por compras en la tienda o recompensas.
/// Lo "disponible para colocar" = freeItems globales (map_objects) + quantity
/// de acá − lo ya colocado en su mapa (profiles_map_objects.objects).
model ProfileMapItem {
  id        BigInt   @id @default(autoincrement())
  profileId Int      @map("profile_id")
  type      String   @db.VarChar(30)
  variant   Int      @default(0)
  quantity  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([profileId, type, variant], map: "profiles_map_items_unique_item")
  @@index([profileId], map: "idx_profiles_map_items_profile_id")
  @@map("profiles_map_items")
}

model ProfileReward {
  id        BigInt   @id @default(autoincrement())
  profileId Int      @map("profile_id")
  rewardId  BigInt   @map("reward_id")
  amount    Decimal  @db.Decimal
  // Why this reward was granted — the single ledger discriminator (replaced the
  // old `type` collected/earned column). Daily check-in rewards use
  // 'daily-checkin'; achievement credits use 'achievement'. Combined with
  // `reward_id` it identifies any reward's source.
  reason    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reward  Reward  @relation(fields: [rewardId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([profileId], map: "idx_profiles_rewards_profile_id")
  @@index([rewardId], map: "idx_profiles_rewards_reward_id")
  @@map("profiles_rewards")
}

model Reward {
  id        BigInt    @id @default(autoincrement())
  key       String?
  name      String?   @default("")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  profileRewards ProfileReward[]

  @@map("rewards")
}

model Token {
  id                           Int       @id @default(autoincrement())
  name                         String    @db.VarChar(50)
  symbol                       String    @db.VarChar(20)
  decimals                     Int?
  isNative                     Boolean   @default(false) @map("is_native")
  isGas                        Boolean   @default(false) @map("is_gas")
  isSupported                  Boolean   @default(false) @map("is_supported")
  contractAddress              String?   @map("contract_address") @db.VarChar(128)
  vaquitaContractAddress       String?   @map("vaquita_contract_address") @db.VarChar(128)
  lockPeriods                  BigInt[]  @default([]) @map("lock_periods")
  defindexVaultContractAddress String?   @map("defindex_vault_contract_address")
  // Issuer (G-address) of the asset behind contract_address; tells this asset
  // apart from same-code assets from other issuers.
  issuer                       String?   @db.VarChar(56)
  // Blend V2 pool that accepts this token as reserve (direct-to-Blend deposit).
  blendPoolContractAddress     String?   @map("blend_pool_contract_address") @db.VarChar(128)

  createdAt                    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                    DateTime? @map("deleted_at") @db.Timestamptz(6)

  deposits Deposit[]

  @@map("tokens")
}

model Withdrawal {
  id                  Int       @id @default(autoincrement())
  depositId           Int       @map("deposit_id")
  status              String    @default("initiated") @db.VarChar(20)
  transactionHash     String?   @map("transaction_hash") @db.VarChar(100)
  transactionEventRaw String?   @map("transaction_event_raw")
  transferAmount      Decimal?  @map("transfer_amount") @db.Decimal
  interest            Decimal?  @db.Decimal
  reward              Decimal?  @db.Decimal
  confirmedAt         DateTime? @map("confirmed_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)

  deposit Deposit @relation(fields: [depositId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([depositId], map: "idx_withdrawals_deposit_id")
  @@index([status], map: "idx_withdrawals_status")
  @@map("withdrawals")
}

// Admin-only snapshot of a wallet's on-chain USDC positions (Blend + DeFindex
// vault), written by the admin Wallets tab scrapes/search. Read on-chain, cached
// here so the tab loads instantly and only hits (rate-limited public) RPC on
// demand. `tokenId` is a plain scalar (no FK — relations are app-layer here).
model WalletBalance {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walletAddress String    @map("wallet_address") @db.VarChar(100)
  tokenId       Int       @map("token_id")
  blendUsdc     Decimal   @default(0) @map("blend_usdc") @db.Decimal
  vaultUsdc     Decimal   @default(0) @map("vault_usdc") @db.Decimal
  // Locked Vaquita-pool deposits by lock period: [{ period, amount }] (from the
  // deposits table). Persisted so the snapshot row is a self-contained record.
  vaquitaPositions Json   @default(dbgenerated("'[]'::jsonb")) @map("vaquita_positions")
  scrapedAt     DateTime  @map("scraped_at") @db.Timestamptz(6)
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([walletAddress, tokenId], map: "wallet_balances_wallet_token_unique")
  @@index([tokenId], map: "idx_wallet_balances_token_id")
  @@map("wallet_balances")
}

/// Append-only record of a user accepting the Privacy Policy / Terms of Service
/// / Risk Disclosure bundle. One row per acceptance — a boolean on Profile would
/// be overwritten by the next policy revision and lose the evidence of what was
/// agreed the first time.
///
/// Deliberately has NO database-level foreign key on profileId (matching the
/// rest of this schema, where relations are enforced in the application layer).
/// That is load-bearing here: the acceptance is evidence about a wallet and must
/// outlive the profile row, so `walletAddress` is denormalized alongside it.
///
/// No IP address is stored — the API drops IPs from its logs by design, and
/// collecting them to infer jurisdiction would widen the privacy footprint the
/// policy has to disclose. `countryCode` is populated only when an upstream
/// proxy provides a coarse country header.
model LegalAcceptance {
  id            Int    @id @default(autoincrement())
  profileId     Int    @map("profile_id")
  walletAddress String @map("wallet_address") @db.VarChar(100)
  /// Bundle version accepted, matched against Config.legalPolicyVersion.
  policyVersion String @map("policy_version") @db.VarChar(20)
  /// Per-document versions inside the bundle: { privacy, terms, risk }.
  acceptedDocuments Json @default("{}") @map("accepted_documents") @db.JsonB
  /// The separate eligibility representation: 18+, not resident in a sanctioned
  /// or restricted jurisdiction, not on a sanctions list.
  jurisdictionAttested Boolean @default(false) @map("jurisdiction_attested")
  countryCode   String?  @map("country_code") @db.Char(2)
  userAgent     String?  @map("user_agent") @db.VarChar(300)
  locale        String?  @db.VarChar(10)
  acceptedAt    DateTime @default(now()) @map("accepted_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id])

  @@index([profileId, acceptedAt(sort: Desc)], map: "idx_legal_acceptances_profile")
  @@index([walletAddress], map: "idx_legal_acceptances_wallet")
  @@map("legal_acceptances")
}

/// Last-known-good DeFindex vault APY per (network, vault). Written by
/// `getVaultApy` on every successful upstream read and read back only when the
/// in-memory cache is cold and DeFindex is unavailable. Derived cache state,
/// not configuration — safe to truncate at the cost of one cold start.
model VaultApySnapshot {
  network      String   @db.VarChar(20)
  vaultAddress String   @map("vault_address") @db.VarChar(128)
  apy          Float
  /// When this rate was last confirmed live upstream.
  fetchedAt    DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@id([network, vaultAddress])
  @@map("vault_apy_snapshots")
}

/// Append-only samples of the DeFindex vault's total managed funds — the real
/// TVL behind the product, as opposed to the deposits ledger's locked principal
/// (which excludes accrued yield and flexible balances).
///
/// Written best-effort from the API's vault-APY path, so samples follow traffic
/// rather than a fixed cadence. Readers must take the LAST sample in a bucket,
/// not an average, since an uneven sampling rate would otherwise weight busy
/// hours more heavily. Derived state — safe to truncate, at the cost of history.
model VaultTvlSnapshot {
  id           BigInt   @id @default(autoincrement())
  network      String   @db.VarChar(20)
  vaultAddress String   @map("vault_address") @db.VarChar(128)
  /// Idle + invested, in human units (already scaled by the token's decimals).
  totalManaged Float    @map("total_managed")
  /// Vault shares outstanding, for share-price context. Null when unreadable.
  totalSupply  Float?   @map("total_supply")
  fetchedAt    DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)

  @@index([network, vaultAddress, fetchedAt(sort: Desc)], map: "idx_vault_tvl_snapshots_vault_time")
  @@map("vault_tvl_snapshots")
}
