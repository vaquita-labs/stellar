# Postgres connection strings from Supabase → Project Settings → Database.
#
# Scope note: this package does not load dotenv at runtime — a `.env` in
# packages/db is only read by the Prisma CLI (via prisma.config.ts). At
# runtime, DATABASE_URL must come from the consuming app's environment
# (apps/api, apps/admin, apps/metrics, apps/reconciler, analytics).
#
# DATABASE_URL — pooled connection (Supavisor / pgbouncer), port 6543. The
# `?pgbouncer=true` flag is required so Prisma disables prepared statements
# (pgbouncer transaction mode does not support them).
DATABASE_URL=postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true

# DIRECT_URL — direct connection, port 5432. CLI-only: used by `prisma studio`,
# `db push` and the sql/ runner (scripts/apply-sql.mjs); safe to leave unset in
# CI/Docker (prisma generate does not connect). Do not run `prisma db pull`:
# the schema header in prisma/schema.prisma forbids it (the schema is
# deliberately ahead of the live DB).
DIRECT_URL=postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# NODE_ENV — controls the Prisma log level (warn+error in development, error
# only otherwise) and client caching on globalThis for hot-reload.
NODE_ENV=development
