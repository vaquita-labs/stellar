# Postgres connection strings from Supabase → Project Settings → Database.
#
# NOTA sobre alcance: este paquete NO carga dotenv en runtime — un `.env` en
# packages/db solo lo lee la CLI de Prisma (via prisma.config.ts). En runtime,
# DATABASE_URL debe venir del entorno de la app consumidora (apps/api,
# apps/admin, bridge-worker).
#
# DATABASE_URL — pooled connection (Supavisor / pgbouncer), port 6543. REQUIRED
# (validated with zod in src/index.ts — the process fails at module load if it
# is missing). The `?pgbouncer=true` flag is required so Prisma disables
# prepared statements (pgbouncer transaction mode does not support them).
DATABASE_URL="postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL — direct connection, port 5432. CLI-only: used by `prisma studio`
# and `db push`; safe to leave unset in CI/Docker (prisma generate does not
# connect). OJO: el header de prisma/schema.prisma prohíbe correr `prisma db
# pull` — el schema va deliberadamente adelantado a la DB viva.
DIRECT_URL="postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres"

# NODE_ENV — controla el log level de Prisma (warn+error en development, solo
# error en el resto) y el cacheo del cliente en globalThis para hot-reload.
# REQUIRED (validated with zod in src/index.ts).
NODE_ENV=development
