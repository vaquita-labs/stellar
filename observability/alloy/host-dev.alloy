// Vaquita — Grafana Alloy for the dev host (dev/testnet + staging/mainnet). Metrics.
// Managed in-repo per docs/grafana-cloud-observability-prd.md (issue 038).
//
// One Alloy per host. This host runs the dev and staging api-services, scraped
// as SEPARATE targets with per-target `environment` labels so shared host
// metrics aren't duplicated. Logs are added in a follow-up (see runbook).
//
// Credentials via sys.env(...); no secrets committed.

// ============================================================================
// Grafana Cloud — metrics remote write
// ============================================================================
prometheus.remote_write "grafana_cloud" {
	endpoint {
		name = "hosted-prometheus"
		url  = sys.env("GRAFANA_CLOUD_PROMETHEUS_REMOTE_WRITE_URL")

		basic_auth {
			username = sys.env("GRAFANA_CLOUD_PROMETHEUS_USERNAME")
			password = sys.env("GRAFANA_CLOUD_PROMETHEUS_API_KEY")
		}
	}

	// `environment` is set per-target below (dev vs staging), NOT globally,
	// because this host serves two environments. Keep labels bounded.
	external_labels = {
		project = "vaquita",
		host    = "host-dev",
	}
}

// ============================================================================
// Vaquita API — one private scrape target per environment on this host.
// Each api-service must run the metrics code and OBSERVABILITY_METRICS_ENABLED=true.
// ============================================================================
prometheus.scrape "vaquita_api" {
	targets = [
		{ __address__ = "vaquita-apiservice-ni4qwm:3100", environment = "dev", service = "api" },
		{ __address__ = "vaquita-apiservice-q9savv:3100", environment = "staging", service = "api" },
	]

	metrics_path    = "/api/v1/metrics"
	scrape_interval = "30s"
	forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

// ============================================================================
// Host / node metrics (collected once for this host; no per-env label)
// ============================================================================
prometheus.exporter.unix "host" {
	procfs_path = "/host/proc"
	sysfs_path  = "/host/sys"
	rootfs_path = "/rootfs"

	filesystem {
		mount_points_exclude = "^/(dev|proc|sys|var/lib/docker/.+)($|/)"
		fs_types_exclude     = "^(autofs|binfmt_misc|cgroup|configfs|debugfs|devpts|devtmpfs|fusectl|hugetlbfs|mqueue|nsfs|overlay|proc|procfs|pstore|securityfs|sysfs|tmpfs|tracefs)$"
	}
}

prometheus.scrape "host" {
	targets         = prometheus.exporter.unix.host.targets
	scrape_interval = "30s"
	forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

// ============================================================================
// Container metrics (cAdvisor over the Docker socket; host-wide, best-effort)
// ============================================================================
prometheus.exporter.cadvisor "containers" {
	docker_host      = "unix:///var/run/docker.sock"
	storage_duration = "5m"
}

prometheus.scrape "containers" {
	targets         = prometheus.exporter.cadvisor.containers.targets
	scrape_interval = "30s"
	forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

// ============================================================================
// Logs — api-service container logs → Grafana Cloud Loki.
// Option 1: explicit slug→environment mapping (Dokploy sets no env labels; the
// only signal is the Swarm service name). App-level redaction (issue 037) is the
// first layer; loki.process below is the second. Bounded Loki labels only:
// project, environment, service, host, container, level.
// ============================================================================
discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "api_logs" {
	targets = discovery.docker.containers.targets

	// Keep only this host's api-service containers.
	rule {
		source_labels = ["__meta_docker_container_label_com_docker_swarm_service_name"]
		regex         = "vaquita-apiservice-(ni4qwm|q9savv)"
		action        = "keep"
	}
	// environment from the slug
	rule {
		source_labels = ["__meta_docker_container_label_com_docker_swarm_service_name"]
		regex         = "vaquita-apiservice-ni4qwm"
		target_label  = "environment"
		replacement   = "dev"
	}
	rule {
		source_labels = ["__meta_docker_container_label_com_docker_swarm_service_name"]
		regex         = "vaquita-apiservice-q9savv"
		target_label  = "environment"
		replacement   = "staging"
	}
	// bounded static + derived labels
	rule {
		target_label = "project"
		replacement  = "vaquita"
	}
	rule {
		target_label = "host"
		replacement  = "host-dev"
	}
	rule {
		target_label = "service"
		replacement  = "api"
	}
	rule {
		source_labels = ["__meta_docker_container_label_com_docker_swarm_service_name"]
		target_label  = "container"
	}
}

loki.source.docker "api" {
	host          = "unix:///var/run/docker.sock"
	targets       = discovery.docker.containers.targets
	relabel_rules = discovery.relabel.api_logs.rules
	forward_to    = [loki.process.hygiene.receiver]
}

loki.process "hygiene" {
	// Drop entries older than Grafana Cloud Loki's acceptance window (~7 days).
	// On first collection of a long-running container Alloy reads the whole log
	// history; without this, the ancient backlog is rejected (HTTP 400 "timestamp
	// too old") and jams the pipeline so recent logs never ship.
	stage.drop {
		older_than          = "168h"
		drop_counter_reason = "too_old"
	}

	// Promote pino's level into a bounded label.
	stage.json {
		expressions = {
			level = "level",
		}
	}

	stage.labels {
		values = {
			level = "",
		}
	}

	// Second-layer redaction: scrub bearer tokens that might appear inside a
	// message string (structured secret fields are already redacted app-side).
	stage.replace {
		expression = "(?i)bearer\\s+[A-Za-z0-9._-]+"
		replace    = "Bearer [REDACTED]"
	}

	forward_to = [loki.write.grafana_cloud.receiver]
}

loki.write "grafana_cloud" {
	endpoint {
		// GRAFANA_CLOUD_LOKI_PUSH_URL is the base host; the push path is appended.
		url = sys.env("GRAFANA_CLOUD_LOKI_PUSH_URL") + "/loki/api/v1/push"

		basic_auth {
			username = sys.env("GRAFANA_CLOUD_LOKI_USERNAME")
			password = sys.env("GRAFANA_CLOUD_LOKI_API_KEY")
		}
	}
}
