// Vaquita — Grafana Alloy for the prod host (prod/mainnet). Metrics.
// Managed in-repo per docs/grafana-cloud-observability-prd.md (issue 038).
//
// One Alloy per host. This host runs only the prod api-service. Logs are added
// in a follow-up (see runbook). Credentials via sys.env(...); no secrets committed.

// ============================================================================
// Grafana Cloud — metrics remote write
// ============================================================================
prometheus.remote_write "grafana_cloud" {
	endpoint {
		name = "hosted-prometheus"
		url  = sys.env("GRAFANA_CLOUD_PROMETHEUS_REMOTE_WRITE_URL")

		basic_auth {
			username = sys.env("GRAFANA_CLOUD_PROMETHEUS_USERNAME")
			password = sys.env("GRAFANA_CLOUD_PROMETHEUS_API_KEY")
		}
	}

	external_labels = {
		project = "vaquita",
		host    = "host-prod",
	}
}

// ============================================================================
// Vaquita API — prod private scrape target.
// The prod api-service must run the metrics code and OBSERVABILITY_METRICS_ENABLED=true.
// ============================================================================
prometheus.scrape "vaquita_api" {
	targets = [
		{ __address__ = "vaquita-api-service-7ksgla:3100", environment = "prod", service = "api" },
	]

	metrics_path    = "/api/v1/metrics"
	scrape_interval = "30s"
	forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

// ============================================================================
// Host / node metrics
// ============================================================================
prometheus.exporter.unix "host" {
	procfs_path = "/host/proc"
	sysfs_path  = "/host/sys"
	rootfs_path = "/rootfs"

	filesystem {
		mount_points_exclude = "^/(dev|proc|sys|var/lib/docker/.+)($|/)"
		fs_types_exclude     = "^(autofs|binfmt_misc|cgroup|configfs|debugfs|devpts|devtmpfs|fusectl|hugetlbfs|mqueue|nsfs|overlay|proc|procfs|pstore|securityfs|sysfs|tmpfs|tracefs)$"
	}
}

prometheus.scrape "host" {
	targets         = prometheus.exporter.unix.host.targets
	scrape_interval = "30s"
	forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

// ============================================================================
// Container metrics (cAdvisor over the Docker socket)
// ============================================================================
prometheus.exporter.cadvisor "containers" {
	docker_host      = "unix:///var/run/docker.sock"
	storage_duration = "5m"
}

prometheus.scrape "containers" {
	targets         = prometheus.exporter.cadvisor.containers.targets
	scrape_interval = "30s"
	forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
}

// ============================================================================
// Logs — prod api-service container logs → Grafana Cloud Loki.
// Option 1: explicit slug→environment mapping. App-level redaction (issue 037)
// is the first layer; loki.process below is the second. Bounded Loki labels
// only: project, environment, service, host, container, level.
// ============================================================================
discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "api_logs" {
	targets = discovery.docker.containers.targets

	// Keep only the prod api-service container.
	rule {
		source_labels = ["__meta_docker_container_label_com_docker_swarm_service_name"]
		regex         = "vaquita-api-service-7ksgla"
		action        = "keep"
	}
	rule {
		target_label = "environment"
		replacement  = "prod"
	}
	rule {
		target_label = "project"
		replacement  = "vaquita"
	}
	rule {
		target_label = "host"
		replacement  = "host-prod"
	}
	rule {
		target_label = "service"
		replacement  = "api"
	}
	rule {
		source_labels = ["__meta_docker_container_label_com_docker_swarm_service_name"]
		target_label  = "container"
	}
}

loki.source.docker "api" {
	host          = "unix:///var/run/docker.sock"
	targets       = discovery.docker.containers.targets
	relabel_rules = discovery.relabel.api_logs.rules
	forward_to    = [loki.process.hygiene.receiver]
}

loki.process "hygiene" {
	stage.json {
		expressions = {
			level = "level",
		}
	}

	stage.labels {
		values = {
			level = "",
		}
	}

	stage.replace {
		expression = "(?i)bearer\\s+[A-Za-z0-9._-]+"
		replace    = "Bearer [REDACTED]"
	}

	forward_to = [loki.write.grafana_cloud.receiver]
}

loki.write "grafana_cloud" {
	endpoint {
		url = sys.env("GRAFANA_CLOUD_LOKI_PUSH_URL") + "/loki/api/v1/push"

		basic_auth {
			username = sys.env("GRAFANA_CLOUD_LOKI_USERNAME")
			password = sys.env("GRAFANA_CLOUD_LOKI_API_KEY")
		}
	}
}
